APP_ENV=production

# MariaDB on the production host
DB_HOST=
DB_PORT=3306
DB_NAME=tds_customer
DB_USER=
DB_PASS=

# Auth — verify JWTs against tds-auth-api JWKS
AUTH_API_URL=https://api.tracht-digital.de/auth
JWKS_CACHE_TTL=600

# Shared admin secret — gates POST /admin/customers here and is the
# Bearer we send to tds-auth-api POST /admin/customer-credentials.
# Must match tds-auth-api's + tds-content-api's ADMIN_TOKEN.
ADMIN_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_RETURN_URL=https://app.tracht-digital.de/invoices

# Document storage — outside any webroot, mode 700, created by install.php bootstrap
DOCUMENT_ROOT_DIR=/home/<deploy-user>/customer-files
DOCUMENT_SIGN_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=https://app.tracht-digital.de,https://admin.tracht-digital.de,http://localhost:4321
