APP_ENV=production

# MariaDB on the production host
DB_HOST=
DB_PORT=3306
DB_NAME=tds_customer
DB_USER=
DB_PASS=

# Auth — verify JWTs against tds-auth-api JWKS
AUTH_API_URL=https://api.tracht-digital.de/auth
JWKS_CACHE_TTL=600

# Admin endpoints are now gated by a per-admin JWT (admin=true claim, verified
# via JWKS) — not a shared token. The only remaining use of a shared secret is
# the server-to-server onboarding call to tds-auth-api
# (POST /admin/customer-credentials): SERVICE_TOKEN must match tds-auth-api's
# SERVICE_TOKEN. Falls back to ADMIN_TOKEN when unset.
SERVICE_TOKEN=
ADMIN_TOKEN=

# --- Runtime service config (app_setting store) ---------------------------
# Stripe, the ticket mailer (Resend) and Lexware below are now ALSO editable
# at runtime from the admin panel (Einrichtungsassistent / Einstellungen),
# stored in the app_setting DB table. Precedence: a non-empty DB value wins,
# else the env var here, else the coded default. So these env vars are an
# optional fallback/seed — leave them blank and configure via the admin panel,
# or set them here to preseed. SETTINGS_ENCRYPTION_KEY encrypts secret values
# (API keys / webhook secret) at rest with AES-256-GCM; generate a long random
# string (the installer does this). Empty = secrets stored in plaintext (dev).
SETTINGS_ENCRYPTION_KEY=

# Stripe (DB-overridable — see above)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_RETURN_URL=https://app.tracht-digital.de/invoices

# Document storage — outside any webroot, mode 700, created by install.php bootstrap
DOCUMENT_ROOT_DIR=/home/<deploy-user>/customer-files
DOCUMENT_SIGN_SECRET=

# Lexware Office (formerly lexoffice) — time-tracking → invoice export.
# DB-overridable via the admin panel (see SETTINGS_ENCRYPTION_KEY note above).
# Optional: when LEXWARE_API_KEY is empty the export endpoint returns 503
# and the admin UI shows the feature as unconfigured. The key is the
# Bearer API key from Lexware Office > Einstellungen > öffentliche API.
# LEXWARE_API_URL points at the sandbox during testing
# (https://api.lexware-sandbox.de/v1).
LEXWARE_API_KEY=
LEXWARE_API_URL=https://api.lexware.io/v1
# Default net hourly rate (€) prefilled in the export form; 0 = require it per export.
LEXWARE_DEFAULT_HOURLY_RATE=0
LEXWARE_TAX_RATE_PERCENT=19

# Ticket notification emails (Resend). DB-overridable via the admin panel
# (see SETTINGS_ENCRYPTION_KEY note above). Optional: when RESEND_API_KEY is empty
# the mailer no-ops (tickets still work in-app). Each event is additionally
# gated by the admin's ticket notification toggles (ticket_setting table).
# TICKET_ADMIN_EMAIL is where "new ticket" notices go; empty = don't send them.
RESEND_API_KEY=
TICKET_MAIL_FROM="Tracht Digital Solutions <noreply@tracht-digital.de>"
TICKET_ADMIN_EMAIL=
# Base URLs used to build the "open ticket" links in notification emails.
ADMIN_APP_URL=https://management.tracht-digital.de
CUSTOMER_APP_URL=https://app.tracht-digital.de

# CORS
CORS_ALLOWED_ORIGINS=https://app.tracht-digital.de,https://management.tracht-digital.de,http://localhost:4321
