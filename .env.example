APP_ENV=production

# MariaDB on the production host
DB_HOST=
DB_PORT=3306
DB_NAME=tds_customer
DB_USER=
DB_PASS=

# Auth — verify JWTs against tds-auth-api JWKS
AUTH_API_URL=https://api.tracht-digital.de/auth
JWKS_CACHE_TTL=600

# Shared admin secret — gates POST /admin/customers here and is the
# Bearer we send to tds-auth-api POST /admin/customer-credentials.
# Must match tds-auth-api's + tds-content-api's ADMIN_TOKEN.
ADMIN_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_RETURN_URL=https://app.tracht-digital.de/invoices

# Document storage — outside any webroot, mode 700, created by install.php bootstrap
DOCUMENT_ROOT_DIR=/home/<deploy-user>/customer-files
DOCUMENT_SIGN_SECRET=

# Lexware Office (formerly lexoffice) — time-tracking → invoice export.
# Optional: when LEXWARE_API_KEY is empty the export endpoint returns 503
# and the admin UI shows the feature as unconfigured. The key is the
# Bearer API key from Lexware Office > Einstellungen > öffentliche API.
# LEXWARE_API_URL points at the sandbox during testing
# (https://api.lexware-sandbox.de/v1).
LEXWARE_API_KEY=
LEXWARE_API_URL=https://api.lexware.io/v1
# Default net hourly rate (€) prefilled in the export form; 0 = require it per export.
LEXWARE_DEFAULT_HOURLY_RATE=0
LEXWARE_TAX_RATE_PERCENT=19

# CORS
# NOTE: https://management.tracht-digital.de is a TEMPORARY alias while the admin
# panel is migrated back to https://admin.tracht-digital.de — remove once moved.
CORS_ALLOWED_ORIGINS=https://app.tracht-digital.de,https://admin.tracht-digital.de,https://management.tracht-digital.de,http://localhost:4321
