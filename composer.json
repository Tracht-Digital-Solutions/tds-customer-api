{
  "name": "tracht-digital-solutions/tds-customer-api",
  "description": "Customer portal data API (projects, invoices, documents, messages) for TDS",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "ext-fileinfo": "*",
    "slim/slim": "^4.13",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/guzzle": "^7.9",
    "stripe/stripe-php": "^16.0",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "robmorgan/phinx": "^0.16"
  },
  "autoload": {
    "psr-4": {
      "Tds\\CustomerApi\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "start": "php -S localhost:8004 -t public",
    "migrate": "phinx migrate -e local",
    "migrate:prod": "phinx migrate -e production"
  }
}
